---
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  width?: 'content' | 'prose' | 'narrow';
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  width = 'content',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Section spacing="compact" border="bottom">
    <Container width="content">
      <Stack space="lg">
        {eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
        <h1 class="page-heading">{heading}</h1>
        {intro && <p class="page-intro">{intro}</p>}
      </Stack>
    </Container>
  </Section>

  <Section>
    <Container width={width}>
      <slot />
    </Container>
  </Section>

  <slot name="after" />
</BaseLayout>

<style>
  .page-eyebrow,
  .page-heading,
  .page-intro {
    margin: 0;
  }

  .page-eyebrow {
    color: var(--primary);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    line-height: var(--type-label-line-height);
    text-transform: uppercase;
  }

  .page-heading {
    max-width: var(--container-content);
    font-size: var(--type-heading-1-size);
    font-weight: var(--type-heading-1-weight);
    letter-spacing: var(--type-heading-1-tracking);
    line-height: var(--type-heading-1-line-height);
  }

  .page-intro {
    max-width: var(--container-prose);
    color: var(--muted-foreground);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-line-height);
  }
</style>
