---
import FictionalDisclosure from '@/components/ui/FictionalDisclosure.astro';
import SiteFooter from '@/components/ui/SiteFooter.astro';
import SiteHeader from '@/components/ui/SiteHeader.astro';
import { serializeJsonLd, type JsonLd } from '@/lib/schema';
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME } from '@/lib/seo/site';
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import sourceSerifFontUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  canonical?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  robots?: string;
  schemas?: JsonLd[];
}

const {
  title,
  description,
  bodyClass,
  canonical,
  socialImage = DEFAULT_SOCIAL_IMAGE,
  socialImageAlt = SITE_NAME,
  ogType = 'website',
  robots = 'noindex, follow',
  schemas = [],
} = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL(socialImage, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={sourceSerifFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {schemas.map((schema) => <script type="application/ld+json" is:inline set:html={serializeJsonLd(schema)} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <FictionalDisclosure />
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: var(--layer-skip-link);
    inset-block-start: var(--space-md);
    inset-inline-start: var(--gutter);
    /* A percentage translation keeps the link hidden regardless of its text size. */
    transform: translateY(-200%);
    border: var(--border-width-emphasis) solid var(--outline);
    border-radius: var(--radius-control);
    background: var(--background);
    padding: var(--space-sm) var(--space-md);
    color: var(--foreground);
    font-size: var(--type-body-sm-size);
    font-weight: var(--type-label-weight);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
