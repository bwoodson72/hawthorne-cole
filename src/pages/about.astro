---
import PageHero from '@/components/patterns/PageHero.astro';
import SectionHeading from '@/components/patterns/SectionHeading.astro';
import Cluster from '@/components/layout/Cluster.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const values = [
  { name: 'Clarity', description: 'Legal complexity should not become communication complexity.' },
  { name: 'Judgment', description: "Knowing the available legal options is only the beginning. Good counsel requires knowing which option serves the client's real objective." },
  { name: 'Preparation', description: "Leverage comes from understanding the facts, the documents, the law, and the other side's likely incentives before a decision has to be made." },
  { name: 'Restraint', description: 'Not every disagreement should become a lawsuit, and not every transaction needs unnecessary complexity.' },
  { name: 'Accountability', description: 'The attorney responsible for the matter should remain accessible to the client.' },
] as const;
---

<BaseLayout
  title="About Hawthorne & Cole | Fort Worth Attorneys"
  description="Learn about the fictional Hawthorne & Cole law firm and its approach to business, real estate, estate planning, litigation, and probate matters."
>
  <PageHero
    eyebrow="About the Firm"
    title="Deliberate counsel for complicated decisions."
    intro="Hawthorne & Cole was founded around a simple idea: clients should understand not only what the law allows, but what each available course of action is likely to mean for their business, property, family, and future."
    variant="compact"
  />

  <Section>
    <Container>
      <div class="narrative-section">
        <SectionHeading heading="Legal problems rarely exist in isolation." />
        <Stack space="lg" class="narrative-copy">
          <p>A contract dispute may affect a customer relationship that took years to build. A real estate transaction may shape a company's finances for the next decade. An estate plan may determine whether a family business survives a generational transition.</p>
          <p>Those consequences are why the firm begins with context.</p>
          <p>Before recommending a course of action, we work to understand what the client is trying to preserve, change, avoid, or accomplish. The legal strategy follows from that objective.</p>
        </Stack>
      </div>
    </Container>
  </Section>

  <Section tone="muted" border="both">
    <Container>
      <div class="narrative-section">
        <SectionHeading heading="Clear advice. Direct communication. Practical strategy." />
        <Stack space="lg" class="narrative-copy">
          <p>Clients should not need to translate their attorney's advice before they can use it.</p>
          <p>We explain the legal position plainly, identify the meaningful risks, and distinguish between what is possible and what is sensible.</p>
          <p>When negotiation offers a better outcome than litigation, we say so. When a client's position needs to be defended decisively, we prepare accordingly.</p>
        </Stack>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <Stack space="xl">
        <SectionHeading eyebrow="What Guides the Work" heading="Values" />
        <ol class="values-list">
          {values.map((value, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{value.name}</h3><p>{value.description}</p></div>
            </li>
          ))}
        </ol>
      </Stack>
    </Container>
  </Section>

  <Section tone="inverse" spacing="compact" border="both">
    <Container width="content">
      <Stack space="lg" class="about-closing">
        <h2>Built for clients who want to understand what comes next.</h2>
        <p>Hawthorne & Cole represents businesses, property owners, executors, and families throughout Fort Worth and North Texas.</p>
        <Cluster space="md">
          <LinkButton href="/attorneys/" variant="inverse">Meet Our Attorneys</LinkButton>
          <LinkButton href="/consultation/" variant="secondary" class="inverse-outline">Schedule a Consultation</LinkButton>
        </Cluster>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  .narrative-section { display: grid; gap: var(--content-gap); }
  .narrative-copy { max-width: var(--container-prose); color: var(--muted-foreground); font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line-height); }
  .narrative-copy p { margin: 0; }
  .values-list { display: grid; margin: 0; padding: 0; border-block-end: var(--border-width-hairline) solid var(--border); list-style: none; }
  .values-list li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-lg); border-block-start: var(--border-width-hairline) solid var(--border); padding-block: var(--space-lg); }
  .values-list li > span { color: var(--accent); font-family: var(--font-family-display), serif; font-size: var(--type-heading-4-size); }
  .values-list li div { display: grid; gap: var(--space-sm); }
  .values-list h3, .values-list p { margin: 0; }
  .values-list h3 { font-size: var(--type-heading-4-size); line-height: var(--type-heading-4-line-height); }
  .values-list p { max-width: var(--container-prose); color: var(--muted-foreground); }
  .about-closing h2, .about-closing p { margin: 0; }
  .about-closing h2 { font-size: var(--type-heading-2-size); font-weight: var(--type-heading-2-weight); letter-spacing: var(--type-heading-2-tracking); line-height: var(--type-heading-2-line-height); }
  .about-closing p { max-width: var(--container-prose); color: var(--inverse-muted-foreground); font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line-height); }
  .about-closing :global(.inverse-outline) { border-color: var(--accent); color: var(--inverse-foreground); }
  .about-closing :global(.inverse-outline:hover) { color: var(--accent); }
  @media (min-width: 48rem) {
    .narrative-section { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .values-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--content-gap); }
  }
</style>
