---
import Container from '@/components/layout/Container.astro';
import FictionalDisclosure from '@/components/ui/FictionalDisclosure.astro';
import {
  attorneyLinks,
  featuredInsightLinks,
  practiceAreaLinks,
  primaryLinks,
} from '@/lib/navigation';

const firmLinks = [
  ...primaryLinks,
  { label: 'Consultation', href: '/consultation/' },
] as const;

const legalLinks = [
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Portfolio Disclosure', href: '/privacy/' },
] as const;
---

<footer class="hc-site-footer bg-inverse text-inverse-foreground">
  <Container>
    <div class="footer-intro">
      <div class="footer-brand">
        <a class="footer-wordmark" href="/">Hawthorne &amp; Cole</a>
        <p>Business, real estate, estate planning, litigation, and probate counsel in Fort Worth, Texas.</p>
      </div>
      <a class="footer-consultation" href="/consultation/">Schedule a Consultation</a>
    </div>

    <div class="footer-grid grid grid-cols-1 md:grid-cols-4">
      <address class="footer-address md:col-span-1">
        <strong>Hawthorne &amp; Cole Attorneys at Law</strong><br />
        500 West 7th Street<br />
        Suite 1800<br />
        Fort Worth, Texas 76102<br />
        <a href="tel:+18175550148">(817) 555-0148</a><br />
        <a href="mailto:contact@hawthornecole.example">contact@hawthornecole.example</a>
      </address>

      <nav class="footer-nav grid grid-cols-2 md:col-span-3 md:grid-cols-4" aria-label="Footer navigation">
        <div>
          <h2 class="footer-heading">Practice Areas</h2>
          <ul class="footer-list">
            {practiceAreaLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="footer-heading">Attorneys</h2>
          <ul class="footer-list">
            {attorneyLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="footer-heading">Insights</h2>
          <ul class="footer-list footer-insights">
            {featuredInsightLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="footer-heading">Firm</h2>
          <ul class="footer-list">
            {firmLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>

          <h2 class="footer-heading footer-legal-heading">Legal</h2>
          <ul class="footer-list">
            {legalLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <FictionalDisclosure variant="full" />
    <p class="footer-copyright">© Hawthorne &amp; Cole. Fictional portfolio concept.</p>
  </Container>
</footer>

<style>
  .hc-site-footer {
    padding-block: var(--section-default) var(--space-xl);
  }

  .footer-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--content-gap);
    padding-block-end: var(--space-xl);
    border-block-end: var(--border-width-hairline) solid var(--border);
  }

  .footer-brand {
    display: grid;
    max-width: var(--container-narrow);
    gap: var(--space-md);
  }

  .footer-brand p,
  .footer-copyright {
    margin: 0;
    color: var(--inverse-muted-foreground);
  }

  .footer-wordmark {
    color: var(--inverse-foreground);
    font-family: var(--font-family-display), serif;
    font-size: var(--type-heading-2-size);
    font-weight: var(--type-heading-2-weight);
    letter-spacing: var(--type-heading-2-tracking);
    line-height: var(--type-heading-2-line-height);
    text-decoration: none;
  }

  .footer-consultation {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width-hairline) solid var(--accent);
    border-radius: var(--radius-control);
    padding: var(--space-sm) var(--space-lg);
    color: var(--inverse-foreground);
    font-size: var(--type-body-sm-size);
    font-weight: var(--type-label-weight);
    text-decoration: none;
  }

  .footer-consultation:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .footer-grid {
    gap: var(--content-gap);
    padding-block: var(--section-compact);
  }

  .footer-address {
    color: var(--inverse-muted-foreground);
    font-size: var(--type-body-sm-size);
    font-style: normal;
    line-height: var(--type-body-lg-line-height);
  }

  .footer-address strong {
    color: var(--inverse-foreground);
  }

  .footer-address a,
  .footer-list a {
    color: inherit;
    text-decoration-color: transparent;
    text-underline-offset: var(--space-xs);
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .footer-address a:hover,
  .footer-list a:hover {
    color: var(--inverse-foreground);
    text-decoration-color: var(--accent);
  }

  .footer-nav {
    gap: var(--content-gap);
  }

  .footer-heading {
    margin: 0 0 var(--space-md);
    color: var(--inverse-foreground);
    font-family: var(--font-family-interface), sans-serif;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    line-height: var(--type-label-line-height);
    text-transform: uppercase;
  }

  .footer-legal-heading {
    margin-block-start: var(--space-xl);
  }

  .footer-list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    color: var(--inverse-muted-foreground);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-line-height);
    list-style: none;
  }

  .footer-copyright {
    padding-block-start: var(--space-lg);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-line-height);
  }
</style>
