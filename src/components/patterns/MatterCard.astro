---
interface Props { title: string; category: string; summary: string; outcome: string; href: string; disclosure?: string; variant?: 'standard' | 'featured'; }
const { title, category, summary, outcome, href, disclosure = 'Fictional portfolio example.', variant = 'standard' } = Astro.props;
---
<article class:list={['matter', `matter--${variant}`]}>
  <p class="matter__category">{category}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="matter__summary">{summary}</p>
  <div class="matter__outcome"><span>Outcome</span><p>{outcome}</p></div>
  <p class="matter__disclosure">{disclosure}</p>
</article>
<style>
  .matter { display: grid; gap: var(--space-md); border: var(--border-width-hairline) solid var(--border); border-radius: var(--radius-card); padding: var(--card-padding); background: var(--surface); }
  .matter--featured { border-block-start: var(--border-width-emphasis) solid var(--accent); background: var(--background); box-shadow: var(--shadow-subtle); }
  .matter__category, .matter h3, .matter__summary, .matter__outcome p, .matter__disclosure { margin: 0; }
  .matter__category, .matter__outcome span { color: var(--primary); font-size: var(--type-caption-size); font-weight: var(--type-caption-weight); letter-spacing: var(--type-caption-tracking); line-height: var(--type-caption-line-height); text-transform: uppercase; }
  .matter h3 { font-size: var(--type-heading-4-size); font-weight: var(--type-heading-4-weight); line-height: var(--type-heading-4-line-height); }
  .matter h3 a { color: inherit; text-decoration: none; }
  .matter h3 a:hover { color: var(--primary); }
  .matter__summary { color: var(--muted-foreground); }
  .matter__outcome { display: grid; gap: var(--space-xs); border-block-start: var(--border-width-hairline) solid var(--border); padding-block-start: var(--space-md); }
  .matter__disclosure { color: var(--muted-foreground); font-size: var(--type-caption-size); font-style: italic; line-height: var(--type-caption-line-height); }
</style>
