---
import Stack from '@/components/layout/Stack.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  level?: 2 | 3;
  align?: 'start' | 'center';
  tone?: 'default' | 'inverse';
}

const { eyebrow, heading, intro, level = 2, align = 'start', tone = 'default' } = Astro.props;
const Heading = `h${level}` as const;
---

<Stack space="md" class:list={['section-heading', `section-heading--${align}`, `section-heading--${tone}`]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading>{heading}</Heading>
  {intro && <p class="section-heading__intro">{intro}</p>}
  <slot />
</Stack>

<style>
  .section-heading { max-width: var(--container-content); }
  .section-heading--center { margin-inline: auto; align-items: center; text-align: center; }
  .section-heading__eyebrow, .section-heading h2, .section-heading h3, .section-heading__intro { margin: 0; }
  .section-heading__eyebrow { color: var(--primary); font-size: var(--type-label-size); font-weight: var(--type-label-weight); letter-spacing: var(--type-label-tracking); line-height: var(--type-label-line-height); text-transform: uppercase; }
  .section-heading--inverse .section-heading__eyebrow { color: var(--accent); }
  .section-heading h2 { font-size: var(--type-heading-2-size); font-weight: var(--type-heading-2-weight); letter-spacing: var(--type-heading-2-tracking); line-height: var(--type-heading-2-line-height); }
  .section-heading h3 { font-size: var(--type-heading-3-size); font-weight: var(--type-heading-3-weight); letter-spacing: var(--type-heading-3-tracking); line-height: var(--type-heading-3-line-height); }
  .section-heading__intro { max-width: var(--container-prose); color: var(--muted-foreground); font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line-height); }
  .section-heading--inverse .section-heading__intro { color: var(--inverse-muted-foreground); }
</style>
