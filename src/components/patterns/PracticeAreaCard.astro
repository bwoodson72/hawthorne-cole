---
interface Props {
  title: string;
  summary: string;
  href: string;
  linkLabel?: string;
  index?: number | string;
  attorney?: string;
  variant?: 'editorial' | 'featured';
  headingLevel?: 2 | 3;
}

const { title, summary, href, linkLabel, index, attorney, variant = 'editorial', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article class:list={['practice-area', `practice-area--${variant}`]}>
  {index !== undefined && <p class="practice-area__index" aria-hidden="true">{String(index).padStart(2, '0')}</p>}
  <div class="practice-area__body">
    <Heading><a href={href}>{title}</a></Heading>
    <p class="practice-area__summary">{summary}</p>
    {attorney && <p class="practice-area__attorney">Counsel: {attorney}</p>}
  </div>
  <a class="practice-area__link" href={href} aria-label={linkLabel ?? `Explore ${title}`}>
    {linkLabel ?? `Explore ${title}`} <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .practice-area { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-lg) var(--content-gap); align-items: start; border-block-start: var(--border-width-hairline) solid var(--border); padding-block: var(--card-padding); }
  .practice-area--featured { border-block-start-color: var(--accent); background: var(--surface); padding-inline: var(--card-padding); }
  .practice-area__index { margin: 0; color: var(--accent); font-family: var(--font-family-display), serif; font-size: var(--type-heading-4-size); line-height: var(--type-heading-4-line-height); }
  .practice-area__body { display: grid; gap: var(--space-md); }
  .practice-area h2, .practice-area h3, .practice-area__summary, .practice-area__attorney { margin: 0; }
  .practice-area h2, .practice-area h3 { font-size: var(--type-heading-3-size); font-weight: var(--type-heading-3-weight); letter-spacing: var(--type-heading-3-tracking); line-height: var(--type-heading-3-line-height); }
  .practice-area h2 a, .practice-area h3 a { color: inherit; text-decoration: none; }
  .practice-area h2 a:hover, .practice-area h3 a:hover { color: var(--primary); }
  .practice-area__summary { max-width: var(--container-prose); color: var(--muted-foreground); line-height: var(--type-body-lg-line-height); }
  .practice-area__attorney { font-size: var(--type-caption-size); font-weight: var(--type-caption-weight); letter-spacing: var(--type-caption-tracking); line-height: var(--type-caption-line-height); text-transform: uppercase; }
  .practice-area__link { grid-column: 2; width: fit-content; color: var(--primary); font-size: var(--type-body-sm-size); font-weight: var(--type-label-weight); text-underline-offset: var(--space-xs); }
  @media (min-width: 48rem) { .practice-area { grid-template-columns: auto minmax(0, 1fr) auto; } .practice-area__link { grid-column: 3; align-self: center; } }
</style>
